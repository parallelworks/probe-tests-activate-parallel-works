{
  "name": "gcp-controller",
  "platform": "activate.parallel.works",
  "user": "alvaro",
  "workflow_name": "hermes-agent",
  "workflow": {
    "repo": "github.com/parallelworks/workflows",
    "path": "workflows/hermes-agent/yamls/general.yaml",
    "ref": "canary"
  },
  "timeout_s": 1800,
  "warm_marker": [
    "${HOME}/pw/software/agent-venv",
    "${HOME}/.hermes"
  ],
  "inputs": {
    "resource": "pw://alvaro/gcpsmall",
    "cluster": {
      "scheduler": false
    },
    "service": {
      "interface": "dashboard",
      "hermes_model": "org:glm/glm-5.1",
      "allocation": "Owners"
    }
  }
}
