{
  "name": "gcp-controller",
  "platform": "activate.parallel.works",
  "user": "alvaro",
  "workflow_name": "n8n",
  "workflow": {
    "repo": "github.com/parallelworks/workflows",
    "path": "workflows/n8n/yamls/general.yaml",
    "ref": "canary"
  },
  "timeout_s": 1800,
  "warm_marker": "${HOME}/pw/software/containers/n8n.sif",
  "inputs": {
    "resource": "pw://alvaro/gcpsmall",
    "cluster": {
      "scheduler": false
    },
    "service": {
      "container_runtime": "n8n-singularity",
      "n8n_data_dir": "${HOME}/pw/n8n"
    }
  }
}
