{
  "name": "gcpsmall-login-python-numpy-auto",
  "platform": "activate.parallel.works",
  "user": "alvaro",
  "workflow_name": "singularity-build",
  "workflow": {
    "repo": "github.com/parallelworks/probe-tests-activate-parallel-works",
    "path": "workflows/activate.hpc.mil/singularity-build/yamls/hsp.yaml",
    "ref": "hsp-tests-singularity"
  },
  "timeout_s": 1200,
  "warm_marker": "${HOME}/pw/software/containers/.cache/cache/blob",
  "inputs": {
    "resource": "pw://alvaro/gcpsmall",
    "container": {
      "definition": "Bootstrap: docker\nFrom: python:3.12-slim\n\n%post\n    pip install --no-cache-dir numpy==2.3.3\n\n%environment\n    export PYTHONUNBUFFERED=1\n\n%runscript\n    exec python \"$@\"\n\n%test\n    python -c \"import numpy; print('numpy', numpy.__version__)\"\n",
      "image_name": "python-numpy.sif",
      "output_dir": "${HOME}/pw/software/containers",
      "test_command": "python -c \"import numpy; print('numpy', numpy.__version__)\""
    },
    "build": {
      "fakeroot": false,
      "timeout_min": 30,
      "options": "",
      "environment": "",
      "cache_dir": ""
    }
  }
}
