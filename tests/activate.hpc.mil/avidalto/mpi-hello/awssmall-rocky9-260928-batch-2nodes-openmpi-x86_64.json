{
  "name": "awssmall-rocky9-260928-batch-2nodes-openmpi-x86_64",
  "platform": "activate.hpc.mil",
  "user": "avidalto",
  "workflow_name": "mpi-hello",
  "workflow": {
    "repo": "github.com/parallelworks/probe-tests-activate-parallel-works",
    "path": "workflows/activate.hpc.mil/mpi-hello/yamls/hsp.yaml",
    "ref": "hsp"
  },
  "timeout_s": 3600,
  "leftover_patterns": [
    "mpi_hello",
    "mpirun"
  ],
  "inputs": {
    "resource": "pw://avidalto/awssmall",
    "cluster": {
      "scheduler": true,
      "nodes": 2,
      "ntasks_per_node": 2,
      "slurm": {
        "is_enabled": true,
        "partition": "batch",
        "time": "00:15:00",
        "scheduler_directives": ""
      }
    },
    "mpi": {
      "load": "module load mpi/openmpi-x86_64",
      "launcher": "mpirun -np"
    }
  }
}
