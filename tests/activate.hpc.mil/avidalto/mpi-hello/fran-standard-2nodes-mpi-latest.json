{
  "name": "fran-standard-2nodes-mpi-latest",
  "platform": "activate.hpc.mil",
  "user": "avidalto",
  "workflow_name": "mpi-hello",
  "workflow": {
    "repo": "github.com/parallelworks/probe-tests-activate-parallel-works",
    "path": "workflows/activate.hpc.mil/mpi-hello/yamls/hsp.yaml",
    "ref": "hsp"
  },
  "timeout_s": 3600,
  "inputs": {
    "resource": "pw://avidalto/fran",
    "cluster": {
      "scheduler": true,
      "nodes": 2,
      "ntasks_per_node": 2,
      "slurm": {
        "is_enabled": true,
        "account": "hpcmo49636prw",
        "partition": "standard",
        "qos": "standard",
        "node_type": "",
        "time": "",
        "scheduler_directives": ""
      }
    },
    "mpi": {
      "load": "module use /p/app/modulefiles\nmodule load mpi/latest",
      "launcher": "mpirun -np"
    }
  }
}
